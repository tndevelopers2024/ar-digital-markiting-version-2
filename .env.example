# Public values: set before building. Never place secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp number with country code. Blank shows a non-working placeholder button.
NEXT_PUBLIC_WHATSAPP_NUMBER=+919653112624
# Optional official social profiles. Leave unused platforms blank.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_BEHANCE_URL=
# Keep false for preview/staging; enable only after launch checks pass.
NEXT_PUBLIC_SITE_INDEXABLE=false
# Server only: your approved HTTPS enquiry receiver, e.g. your CRM/email relay.
# It must durably accept the JSON payload before returning 2xx.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=
