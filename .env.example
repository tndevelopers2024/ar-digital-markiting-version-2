# Public values: set before building. Never place secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=
# Keep false for preview/staging; enable only after launch checks pass.
NEXT_PUBLIC_SITE_INDEXABLE=false
# Server only: your approved HTTPS enquiry receiver, e.g. your CRM/email relay.
# It must durably accept the JSON payload before returning 2xx.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=
